PORT=5000
JWT_SECRET=your_jwt_secret_key_here
DATABASE_URL=postgres://user:password@host:port/defaultdb?sslmode=require
PG_POOL_MAX=5

# Gmail SMTP Configuration for live Email OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="ProGold Platform" <your_email@gmail.com>

# ImageKit Cloud Storage Configuration for Photos, Catalogues & Item Tags
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id/task
